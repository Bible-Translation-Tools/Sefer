{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // The Solid vite plugin's turnkey client mode generates the real entries
  // around these two by file-name convention; nothing imports them.
  "entry": [
    "src/App.tsx",
    "src/Document.tsx",
    // tools/vite/lucideSolid.ts redirects lucide-solid's `solid-js` imports
    // here, so its exports are consumed through a Vite alias no static tool sees.
    "tools/vite/lucideSolidShim.ts",
    // `pnpm test:desktop` hands this config to the `wdio` binary by path, and
    // WebdriverIO loads the specs it names by glob.
    "e2e-desktop/wdio.conf.ts",
    "e2e-desktop/**/*.desktop.ts",
    // `pnpm editor:bench` serves this page by config path; nothing imports it.
    "packages/editor/bench/vite.config.ts",
    "packages/editor/bench/main.ts",
    // Run with `node --test` by the verify-document-import skill; nothing imports it.
    "packages/document-import/src/faithful.verify.ts",
  ],
  // The planning site (planning/) is its own workspace with its own checks
  // (astro check, pnpm plans check), as it is for oxlint and oxfmt.
  "ignorePatterns": ["src/routeTree.gen.ts", "planning/**"],
  "ignoreDependencies": [
    // Loaded by Paraglide's compiler from project.inlang/settings.json `modules`.
    "@inlang/plugin-icu1",
    // Spawned as a binary by tools/tauri/run.ts (`pnpm exec tauri`).
    "@tauri-apps/cli",
    // Loaded by @solidjs/vite-plugin when `diagnostics: true`.
    "@solidjs/diagnostics",
    // The Rust side registers the plugin for "reveal in Finder"; the JS
    // binding is installed ahead of the first screen that calls it.
    "@tauri-apps/plugin-opener",
    // The desktop WebdriverIO runner: `wdio` is spawned as a binary by
    // tools/verify/desktopTest.ts, and the rest are named as strings in
    // e2e-desktop/wdio.conf.ts (runner, framework, reporter, service).
    "@wdio/cli",
    "@wdio/local-runner",
    "@wdio/mocha-framework",
    "@wdio/spec-reporter",
    "@wdio/tauri-service",
  ],
}
