// Sefer's web build as a Cloudflare static-assets Worker.
//
// Each channel has a custom domain. Wrangler provisions the DNS record on
// deploy — the deploy token carries `zone.workers.routes` across the account's
// zones, which is what a Custom Domain is created through — so the hostname
// does not have to exist beforehand.
//
// Declaring `routes` turns the `*.workers.dev` subdomain OFF: `workers_dev`
// defaults to false once a route exists. That is the behaviour we want — one
// canonical hostname per channel rather than two that can drift — but it does
// mean the workers.dev URL stops answering the moment a channel is armed.
// Set `"workers_dev": true` on a channel to keep both.
//
// Modelled on scripture-editor-proto-2's `wrangler.jsonc`, which is the shape
// this organisation already runs.
//
// Static-assets only: no fetch handler, no env vars, no secrets. Cloudflare
// treats static-only workers as a separate deployment class, which is why this
// config sits at the repository root rather than beside a worker source file.
//
// `directory` is `./dist/client` rather than the old repo's `./dist-web`
// because the turnkey Solid Start plugin builds client and server environments
// and puts the static client there. `pnpm build` writes it; `vite build
// --outDir` is ignored by that plugin, so do not try to redirect it.
//
// THE UPDATER WORKER IS NOT HERE. It is its own config, its own hostname and
// its own deploy step — see `planning/02-ready/updater-worker.md`. The old
// repo hit a real bug where wrangler invoked from a subdirectory fell back to
// the root config and redeployed the SPA twice instead of the updater; pass
// `--config` explicitly when that worker lands.
{
  "name": "sefer-web",
  "compatibility_date": "2026-09-21",

  // Workers Logs, on for every channel. `observability` is an INHERITABLE key,
  // so the three envs below pick it up without repeating it — unlike
  // `preview_urls`, which is per-environment and had to be set on `dev` itself.
  //
  // Expect it to record little today: this is a static-assets Worker with no
  // `main`, and a request served straight from assets never invokes a Worker,
  // so there is no invocation to log. It is set now so the first time something
  // here does run code — a fetch handler, a redirect, a header rule — its logs
  // are already being kept, rather than the first incident being what teaches
  // us this was off. The updater worker, which IS pure logic, has had it since
  // it landed (`workers/sefer-updater/wrangler.toml`).
  //
  // `head_sampling_rate` is left at its default of 1. The volume is a static
  // SPA's, and sampling a log you only ever read after something broke is how
  // the one request you needed turns out to be the one that was dropped.
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist/client",
    // Every route is client-side; a deep link must serve the shell rather than
    // 404, or `/project/x/book/JHN` is only reachable by navigating to it.
    "not_found_handling": "single-page-application",
  },
  "env": {
    // A `v*` tag. `pnpm build`, full test suite, full desktop matrix, and the
    // release lint that refuses leftover design scaffolding.
    "production": {
      "name": "sefer-web-production",
      "routes": [
        {
          "pattern": "sefer.bibletranslationtools.org",
          "custom_domain": true,
          "zone_name": "bibletranslationtools.org",
        },
      ],
    },

    // A PROMOTION — `workflow_dispatch`, or a `v0.3.0-1` candidate tag. Not every
    // push: building this on every commit would make it a second `dev`, and the
    // whole point is that somebody can be told to go test drive it. Same
    // build, same tests and same desktop matrix as production; nobody ships a
    // broken Preview.
    "preview": {
      "name": "sefer-web-preview",
      "routes": [
        { "pattern": "sefer-preview.bttdev.org", "custom_domain": true, "zone_name": "bttdev.org" },
      ],
    },

    // Every push to master, web only, built `--mode dev`. The ONE deployed
    // hostname carrying `/design`, the comment panel and `?fixture=1`.
    //
    // Named for the channel rather than for the designer on purpose: the
    // comment collector is a feedback mechanism for anyone slinging code here,
    // not a designer-only tool. Desktop is skipped so a push costs a minute
    // rather than a matrix.
    "dev": {
      "name": "sefer-web-dev",

      // Branch previews live here, and this line is what keeps them alive.
      //
      // `preview_urls` defaults to FALSE, and a deploy writes this file to
      // Cloudflare as the source of truth — so enabling Preview URLs in the
      // dashboard holds only until the next `wrangler deploy`, which then
      // silently turns them back off. Dev only on purpose
      "preview_urls": true,

      "routes": [
        { "pattern": "sefer-dev.bttdev.org", "custom_domain": true, "zone_name": "bttdev.org" },
      ],
    },
  },
}
