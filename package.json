{
  "name": "sefer",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "boundaries": "node tools/boundaries/check.ts",
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "build:tauri": "node tools/tauri/run.ts build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm boundaries && pnpm test:unit && pnpm build",
    "deadcode": "fallow dead-code --unused-files --unused-exports --unused-types --unused-deps --circular-deps",
    "deploy:updater": "node tools/deploy/updater.ts",
    "deploy:web": "node tools/deploy/web.ts",
    "branch:preview": "node tools/deploy/branchPreview.ts",
    "design:scaffolding": "node tools/design/scaffolding.ts",
    "dev": "vite",
    "dev:tauri": "node tools/tauri/run.ts dev",
    "format": "oxfmt . '!**/*.gen.*' '!**/*.md' '!**/*.yaml' '!**/*.yml' '!vendor/**'",
    "format:check": "oxfmt --check . '!**/*.gen.*' '!**/*.md' '!**/*.yaml' '!**/*.yml' '!vendor/**'",
    "lint": "oxlint --max-warnings 0 .",
    "lint:results": "node tools/quality/lintResults.ts",
    "lint:release": "oxlint -c oxlint.release.config.ts .",
    "prepare": "lefthook install",
    "serve": "vite preview",
    "start": "vite",
    "tauri:config": "node tools/tauri/updaterConfig.ts",
    "test": "vitest",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:unit": "vitest run --project core",
    "typecheck": "tsc --noEmit",
    "verify:chrome": "node tools/verify/chrome.ts",
    "verify:design": "node tools/verify/designBundle.ts",
    "verify:launch": "node tools/verify/launch.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@corvu-next/dialog": "0.1.5",
    "@corvu-next/popover": "0.1.5",
    "@corvu-next/tooltip": "0.1.5",
    "@solidjs/web": "^2.0.0-rc.6",
    "@tanstack/solid-router": "^2.0.0-rc.4",
    "@tanstack/virtual-core": "^3.17.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@wycliffeassociates/scripture-kitchen": "github:WycliffeAssociates/scripture-kitchen#v0.1.5",
    "buffer": "6.0.3",
    "effect": "4.0.0-rc.112",
    "fflate": "^0.8.3",
    "isomorphic-git": "1.42.2",
    "lucide-solid": "1.47.0",
    "solid-js": "^2.0.0-rc.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@oxlint/plugins": "1.85.0",
    "@playwright/test": "1.63.0",
    "@solidjs/diagnostics": "^2.0.0-rc.6",
    "@solidjs/vite-plugin": "^3.0.0-next.38",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.40",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "26.6.2",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint-plugin-solid": "~0.18.0",
    "fallow": "3.28.0",
    "lefthook": "2.1.14",
    "magic-string": "^1.4.1",
    "oxc-parser": "^0.151.0",
    "oxfmt": "0.53.0",
    "oxlint": "1.85.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.136.3"
  },
  "packageManager": "pnpm@12.0.0-rc.11"
}
