{
  "name": "sefer",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "boundaries": "node tools/boundaries/check.ts",
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "build:tauri": "node tools/tauri/run.ts build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm boundaries && pnpm test:unit && pnpm build",
    "deadcode": "fallow dead-code --unused-files --unused-exports --unused-types --unused-deps --circular-deps",
    "deploy:updater": "node tools/deploy/updater.ts",
    "deploy:web": "node tools/deploy/web.ts",
    "branch:preview": "node tools/deploy/branchPreview.ts",
    "design:scaffolding": "node tools/design/scaffolding.ts",
    "icons": "node tools/icons/generate.ts",
    "dev": "vite",
    "editor:bench": "vite --config packages/editor/bench/vite.config.ts",
    "dev:tauri": "node tools/tauri/run.ts dev",
    "format": "oxfmt . '!**/*.gen.*' '!documentation/lint-results.md' '!**/*.yaml' '!**/*.yml' '!vendor/**' '!planning/**'",
    "format:check": "oxfmt --check . '!**/*.gen.*' '!documentation/lint-results.md' '!**/*.yaml' '!**/*.yml' '!vendor/**' '!planning/**'",
    "plans": "pnpm --filter planning run plans",
    "lint": "oxlint --max-warnings 0 .",
    "lint:results": "node tools/quality/lintResults.ts",
    "lint:release": "oxlint -c oxlint.release.config.ts .",
    "prepare": "lefthook install && pnpm i18n",
    "serve": "vite preview",
    "start": "vite",
    "tauri:config": "node tools/tauri/updaterConfig.ts",
    "test": "vitest",
    "test:browser": "vitest run --project browser",
    "test:desktop": "node tools/verify/desktopTest.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:unit": "vitest run --project core",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/app/paraglide --emit-ts-declarations --strategy baseLocale --output-structure message-modules",
    "typecheck": "pnpm i18n && tsc --noEmit",
    "verify:chrome": "node tools/verify/chrome.ts",
    "verify:design": "node tools/verify/designBundle.ts",
    "verify:desktop": "node tools/verify/desktop.ts",
    "verify:launch": "node tools/verify/launch.ts",
    "verify:perf": "node tools/verify/perf.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@corvu-next/dialog": "0.1.5",
    "@corvu-next/popover": "0.1.5",
    "@corvu-next/tooltip": "0.1.5",
    "@sefer/document-import": "workspace:*",
    "@sefer/editor": "workspace:*",
    "@sefer/text": "workspace:*",
    "@solidjs/web": "^2.0.0-rc.9",
    "@tanstack/solid-router": "^2.0.0-rc.8",
    "@tanstack/virtual-core": "^3.17.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@wycliffeassociates/scripture-kitchen": "github:WycliffeAssociates/scripture-kitchen#v0.1.15",
    "buffer": "6.0.3",
    "effect": "4.0.0-rc.112",
    "fflate": "^0.8.3",
    "intl-messageformat": "^12.1.2",
    "isomorphic-git": "1.42.2",
    "lucide-solid": "1.47.0",
    "markdown-it": "^14.3.2",
    "solid-js": "^2.0.0-rc.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@inlang/paraglide-js": "2.29.1",
    "@inlang/plugin-icu1": "1.3.4",
    "@oxlint/plugins": "1.85.0",
    "@playwright/test": "1.63.0",
    "@solidjs/diagnostics": "^2.0.0-rc.9",
    "@solidjs/vite-plugin": "^3.0.0-next.44",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.40",
    "@tauri-apps/cli": "2.11.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "26.6.2",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "@wdio/cli": "9.31.9",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "1.5.0",
    "eslint-plugin-solid": "~0.18.0",
    "fallow": "3.34.1",
    "lefthook": "2.1.14",
    "magic-string": "^1.4.1",
    "oxc-parser": "^0.151.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "webdriverio": "9.31.9",
    "wrangler": "^4.136.3"
  },
  "packageManager": "pnpm@12.0.0-rc.11"
}
