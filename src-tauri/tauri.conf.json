{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sefer",
  "version": "0.0.0",
  "identifier": "org.wycliffe.sefer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Sefer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
