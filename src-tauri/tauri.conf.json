{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sefer",
  "version": "0.0.0",
  "identifier": "org.wycliffe.sefer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Sefer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyMEQ5NTYzOTgwRjA3NkYKUldSdkJ3K1lZNVVOSXB6TjEvM1VJRWlaUFhncDFwQ0RualpMbUVVcVJ5Z1RQVUpWSXB4Qk9mdTkK"
    }
  }
}
